<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
        <title>Paramètres - Planify</title>
        <link rel="shortcut icon" href="/images/favicon.ico">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <!-- css -->
        <link href="/css/bootstrap.min.css" rel="stylesheet">
        <link href="/css/nav.css" rel="stylesheet">
        <link href="/css/user/parametres.css" rel="stylesheet">
	</head>
	<body>
		<%- include('../nav') %>
		<form autocomplete="off" action="/user/parametres/verification" method="POST" id="form">
			<header class="parametres">
				<h2>Mes paramètres</h2>
			</header>
			<h4>&nbsp;&nbsp;&nbsp;&nbsp;Modification des informations de connexion</h4>

			<div>
				<label for="username">*Pseudo :</label><br>
				<input type="text" name="username" id="username" placeholder="<%= username %>"/>
				<% if (typeof usernameChanged !== 'undefined') { %>
                    <div class="success" id="server_error">
                        <label class="success_msg"><%= usernameChanged.msg %></label>
                    </div>
				<% } else { %>
					<div class="error" id="server_error" style="display: none;">
						<label class="error_msg"></label>
					</div>
				<% } %>
			</div>
			<div>
				<label for="email">*Adresse e-mail :</label><br>
				<input type="email" name="email" id="email" placeholder="<%= email %>"/>
				<% if (typeof emailError !== 'undefined') { %>
                    <div class="error" id="server_error">
                        <label class="error_msg"><%= emailError.msg %></label>
                    </div>
                <% } %>
				<% if (typeof emailChanged !== 'undefined') { %>
                    <div class="success" id="server_error">
                        <label class="success_msg"><%= emailChanged.msg %></label>
                    </div>
				<% } else { %>
					<div class="error" id="server_error" style="display: none;">
						<label class="error_msg"></label>
					</div>
				<% } %>
			</div>
			<div class="password-container">
				<label for="password">Mot de passe :</label><br>
				<input type="password" id="password" name="password" />
				<img id="show_password" src="/images/close.png" alt="Afficher le mot de passe" height="20" width="20" />
			</div>
			<div class="password_confirm-container">
				<label for="new_password">*Nouveau mot de passe :</label><br>
				<input type="password" name="new_password" id="new_password"/>
				<img id="show_password_confirm" src="/images/close.png" alt="Afficher le mot de passe" height="20" width="20" />
				<% if (typeof passwordChanged !== 'undefined') { %>
                    <div class="success" id="server_error">
                        <label class="success_msg"><%= passwordChanged.msg %></label>
                    </div>
				<% } else { %>
					<div class="error" id="server_error" style="display: none;">
						<label class="error_msg"></label>
					</div>
				<% } %>
			</div>
			<label id="information">*Laissez vide si vous gardez le même champ.</label>
			<div class="error" id="client_error" style="display: none;">
                <label class="error_msg">Les données spécifiées ne sont pas valides.</label>
            </div>
            <% if (typeof error !== 'undefined') { %>
                <div class="error" id="server_error">
                    <label class="error_msg"><%= error.msg %></label>
                </div>
			<% } else { %>
				<div class="error" id="server_error" style="display: none;">
					<label class="error_msg"></label>
				</div>
			<% } %>
			<div class="submit_div">
                <input type="submit" id="enregistrer" value="Enregistrer">
            </div>
		</form>
	</body>
	<!-- script -->
	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<script src="/js/bootstrap.bundle.min.js"></script>
	<script src="/js/client_server_shared/auth.js"></script>
	<script src="/js/auth/authentification.js"></script>
	<script src="/js/user/parametres.js"></script>
</html>