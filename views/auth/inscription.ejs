<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>Inscription - Planify</title>
        <link rel="shortcut icon" href="/images/favicon.ico">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <!-- css -->
        <link href="/css/bootstrap.min.css" rel="stylesheet">
        <link href="/css/authentification.css" rel="stylesheet">
        <link href="/css/inscription.css" rel="stylesheet">
    </head>
    <body>
        <form autocomplete="off" action="inscription/verification" method="post" id="form">
            <header class="authentification">
                <h2>Inscription</h2>
            </header>

            <div id="step1">
                <div>
                    <label for="surname">Nom :</label><br>
                    <input type="text" name="surname" id="surname"
                        value="<%= typeof surname !== 'undefined' ? surname : 'NOM' %>"/>
                </div>
                <div>
                    <label for="name">Prénom :</label><br>
                    <input type="text" name="name" id="name"
                        value="<%= typeof name !== 'undefined' ? name : 'Prénom' %>"/>
                </div>
                <div>
                    <label for="birthdate">Date de naissance :</label><br>
                    <input type="date" name="birthdate" id="birthdate"
                        min="1900-01-01"
                        max="<%= new Date().toISOString().split('T')[0] %>"
                        value="<%= typeof birthdate !== 'undefined' ? birthdate : '2000-01-01' %>"/>
                </div>
                <div class="error" id="client_error1" style="display: none;">
                    <label class="error_msg">Les données spécifiées ne sont pas valides.</label>
                </div>
                <% if (typeof error_step1 !== 'undefined') { %>
                    <div class="error" id="server_error1">
                        <label class="error_msg"><%= error_step1.msg %></label>
                    </div>
                <% } %>
                <div class="suivant_div">
                    <button type="button" class="button" id="suivant">Suivant</button>
                </div>
            </div>

            <div id="step2">
                <div>
                    <label for="id_user">Identifiant :</label><br>
                    <input type="text" name="id_user" id="id_user"
                        value="<%= typeof id_user !== 'undefined' ? id_user : '@userid' %>"/>
                </div>
                <div>
                    <label for="username">Pseudo :</label><br>
                    <input type="text" name="username" id="username"
                        value="<%= typeof username !== 'undefined' ? username : 'Pseudo' %>"/>
                </div>
                <div>
                    <label for="email">Adresse e-mail :</label><br>
                    <input type="email" name="email" id="email"
                        value="<%= typeof email !== 'undefined' ? email : 'adresse@email.com' %>"/>
                </div>
                <div>
                    <label for="password">Mot de passe :</label><br>
                    <input type="password" name="password" id="password" value="motdepasse"/>
                </div>
                <div class="show_password_div">
                    <input type="checkbox" name="show_password" id="show_password"/>
                    <label for="show_password">Afficher le mot de passe</label>
                </div>
                <div class="error" id="client_error2" style="display: none;">
                    <label class="error_msg">Les données spécifiées ne sont pas valides.</label>
                </div>
                <% if (typeof error_step2 !== 'undefined') { %>
                    <div class="error" id="server_error2">
                        <label class="error_msg"><%= error_step2.msg %></label>
                    </div>
                <% } %>
                <div>
                    <button type="button" class="button" id="retour">Retour</button>
                    <input type="submit" id="inscription" value="Inscription">
                </div>
            </div>
        </form>
        <!-- script -->
        <script src="/js/bootstrap.bundle.min.js"></script>
        <script src="/js/jquery.js"></script>
        <script src="/js/shared/auth.js"></script>
        <script src="/js/auth/authentification.js"></script>
        <script src="/js/auth/inscription.js"></script>
    </body>
</html>