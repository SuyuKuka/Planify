<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="css/authentification.css" rel="stylesheet">
    <link href="/css/nav.css" rel="stylesheet"/>
    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
</head>
<body>
    <header class="top-nav">
        <div class="left-nav">
            <img src="/images/empty.png" id="menu" width="44" height="34"/>
            <a href="/index">
                <img src="/images/logo.png" class="logo" width="170" height="40" />
            </a>			
        </div>
        <div class="right-nav">
            <a href="connexion" id="connexion-b" class="button">Se connecter</a>
            <a href="inscription" id="inscription-b" class="button">S'inscrire</a>
        </div>
    </header>
    <% if (mode === "connexion") { %>  
        <form action="/index" method="POST">
            <header class="authentification">
                <h2>Connexion</h2>
            </header>
            <div>
                <label for="email_co">Adresse e-mail :</label><br>
                <input type="email" name="email_co" id="email_co" value="<%= email_co %>" required/>
            </div>
            <div>
                <label for="mdp_co">Mot de passe :</label><br>
                <input type="password" name="mdp_co" id="mdp_co" value="<%= mdp_co %>" required/>
            </div>
            <div class="afficher">
                <input type ="checkbox" name="afficher"/>
                <label>Afficher le mot de passe</label>
            </div>
            <div class="error_connexion" style="display: none;">
                <label class="error">Veuillez remplir tous les champs.</label>
            </div>
            <% if (typeof erreur !== 'undefined') { %>
                <div class="error_message">
                    <label class="error"><%= erreur %></label>
                </div>
            <% } %>
            <div class="reparer">
                <input type="submit" id="connexion" value="Connexion">
            </div>
            <div class="reparer">
                <a href="/mot_de_passe_oublie">Mot de passe oublie ?</a>
            </div>
        </form>
    <% } else if (mode === "inscription") { %>  
        <form action="/connexion" method="POST">
            <header class="authentification">
                <h2>Inscription</h2>
            </header>
            
            <div id="step1">
                <div>
                    <label for="nom">Nom :</label><br>
                    <input type="text" name="nom" id="nom" value="<%= nom %>" required/>
                </div>
                <div>
                    <label for="prenom">Prénom :</label><br>
                    <input type="text" name="prenom" id="prenom" value="<%= prenom %>" required/>
                </div>
                <div>
                    <label for="date">Date de naissance :</label><br>
                    <input type="date" name="date" id="date" value="<%= date %>" required/>
                </div>
                <div class="error_inscription" style="display: none;">
                    <label class="error">Veuillez remplir tous les champs.</label>
                </div>
                <div>
                    <button type="button" class="button" id="suivant">Suivant</button>
                </div>
                <div>
                    <a href="/mot_de_passe_oublie">Mot de passe oublie ?</a>
                </div>
            </div>

            <div id="step2" style="display: none;">
                <div>
                    <label for="pseudo">Pseudo :</label><br>
                    <input type="text" name="pseudo" id="pseudo" value="<%= pseudo %>" required/>
                </div>
                <div>
                    <label for="email">Adresse e-mail :</label><br>
                    <input type="email" name="email" id="email" value="<%= email %>" required/>
                </div>
                <div>
                    <label for="mdp">Mot de passe :</label><br>
                    <input type="password" name="mdp" id="mdp" value="<%= mdp %>" required/>
                </div>
                <div class="afficher">
                    <input type ="checkbox" name="afficher"/>
                    <label>Afficher le mot de passe</label>
                </div>
                <% if (typeof erreur !== 'undefined' && step === 2 && typeof step !== 'undefined') { %>
                    <script>
                        document.getElementById('step1').style.display = 'none';
                        document.getElementById('step2').style.display = 'block';
                    </script>
                    <div class="error_message">
                        <label class="error"><%= erreur %></label>
                    </div>
                <% } %>
                <div class="error_inscription2" style="display: none;">
                    <label class="error">Veuillez remplir tous les champs.</label>
                </div> 
                <div>
                    <button type="button" class="button" id="retour">Retour</button>
                    <input type="submit" id="inscription" value="Inscription">
                </div>
                <div>
                    <a href="/mot_de_passe_oublie">Mot de passe oublie ?</a>
                </div>
            </div>
        </form>
    <% } else if (mode === "mot_de_passe_oublie") { %>
        <form action="/mot_de_passe_oublie" method="POST">
            <header class="authentification">
                <h2>Mot de passe oublié</h2>
            </header>
            <div>
                <label for="email_oublie">Adresse e-mail :</label><br>
                <input type="email" name="email_oublie" id="email_oublie" value="<%= email_oublie %>" required/>
            </div>
            <div class="error_oublie" style="display: none;">
                <label class="error">Veuillez remplir tous les champs.</label>
            </div>
            <% if (typeof erreur !== 'undefined') { %>
                <div class="error_message">
                    <label class="error"><%= erreur %></label>
                </div>
            <% } %>
            <div class="reparer">
                <input type="submit" id="oublie" value="Envoyer">
            </div>
        </form>
    <% } else if (mode === "reinitialisation") { %>
        <form action="/reinitialisation" method="POST">
            <header class="authentification">
                <h2>Réinitialiser son mot de passe</h2>
            </header>
            <input type="hidden" name="token" value="<%= token %>"/>
            <div>
                <label for="mdp_re">Mot de passe :</label><br>
                <input type="password" name="mdp_re" id="mdp_re" value="<%= mdp_re %>" required/>
            </div>
            <div>
                <label for="mdp_re2">Confirmer le mot de passe :</label><br>
                <input type="password" name="mdp_re2" id="mdp_re2" value="<%= mdp_re2 %>" required/>
            </div>
            <div class="afficher">
                <input type ="checkbox" name="afficher"/>
                <label>Afficher le mot de passe</label>
            </div>
            <div class="error_reinitialisation" style="display: none;">
                <label class="error">Veuillez remplir tous les champs.</label>
            </div>
            <% if (typeof erreur !== 'undefined') { %>
                <div class="error_message">
                    <label class="error"><%= erreur %></label>
                </div>
            <% } %>
            <div>
                <input type="submit" id="reinitialisation" value="Envoyer">
            </div>
        </form>
    <% } %>
    <script>
        let champs_inscription = $("input[name='nom'], input[name='prenom'], input[name='date']");
        let champs_inscription2 = $("input[name='pseudo'], input[name='email'], input[name='mdp']");
        let champs_connexion = $("input[name='email_co'], input[name='mdp_co']");
        let champs_oublie = $("input[name='email_oublie']");
        let champs_reinitialisation = $("input[name='mdp_re'], input[name='mdp_re2']");

        function couleurChamps(champs, mode) {
            let empty = false;
            champs.each(function() {
                let input = $(this);
                if (input.val() === "") {
                    empty = true;
                    input.css("border", "2px solid red");
                    input.prev("label").css("color", "red");
                    erreur(mode);
                } else {
                    input.css("border", "");
                    input.prev("label").css("color", "");
                    if (!empty) {
                        erreur("");
                    }
                }
            });
            return empty;
        }

        function updateCouleur(champs) {
            $(champs).on('input', function() {
                let input = $(this);
                if (input.val() !== "") {
                    input.css("border", "");
                    input.prev("label").css("color", "");
                }
            });
        }

        function erreur(mode) {
            if (mode === "inscription") {
                $(".error_inscription").css("display", "block").find(".error").text("Veuillez remplir tous les champs.");
            } else if (mode === "inscription2") {
                $(".error_inscription2").css("display", "block").find(".error").text("Veuillez remplir tous les champs.");
            } else if (mode === "connexion") {
                $(".error_connexion").css("display", "block").find(".error").text("Veuillez remplir tous les champs.");
            } else if (mode === "oublie") {
                $(".error_oublie").css("display", "block").find(".error").text("Veuillez remplir tous les champs.");
            } else if (mode === "reinitialisation") {
                $(".error_reinitialisation").css("display", "block").find(".error").text("Veuillez remplir tous les champs.");
            } else {
                $(".error_inscription").css("display", "none");
                $(".error_inscription2").css("display", "none");
                $(".error_connexion").css("display", "none");
                $(".error_oublie").css("display", "none");
                $(".error_reinitialisation").css("display", "none");
            }
        }

        updateCouleur(champs_inscription);
        updateCouleur(champs_inscription2);
        updateCouleur(champs_connexion);
        updateCouleur(champs_oublie);
        updateCouleur(champs_reinitialisation);

        $("#suivant").click(function() {
            let empty = couleurChamps(champs_inscription, "inscription");
            if (!empty) {
                showStep(2);
            }
        });

        $("#retour").click(function() {
            showStep(1);
        });
        
        $("#inscription").click(function() {
            couleurChamps(champs_inscription2, "inscription2");
        });

        $("#connexion").click(function() {
            couleurChamps(champs_connexion, "connexion");
        });

        $("#oublie").click(function() {
            couleurChamps(champs_oublie, "oublie");
        });

        $("#reinitialisation").click(function() {
            couleurChamps(champs_reinitialisation, "reinitialisation");
        });

        function showStep(step) {
            if (step === 1) {
                document.getElementById('step1').style.display = 'block';
                document.getElementById('step2').style.display = 'none';
            }
            if (step === 2) {
                document.getElementById('step1').style.display = 'none';
                document.getElementById('step2').style.display = 'block';
            }
        }

        $("input[type = 'checkbox']").on("change" ,function() {
            if ($(this).is(":checked")) {
                $("input[name = 'mdp']").prop("type", "text");
                $("input[name = 'mdp_co']").prop("type", "text");
                $("input[name = 'mdp_re'], input[name = 'mdp_re2']").prop("type", "text");
            } else {
                $("input[name = 'mdp']").prop("type", "password");
                $("input[name = 'mdp_co']").prop("type", "password");
                $("input[name = 'mdp_re'], input[name = 'mdp_re2']").prop("type", "password");
            }
        });

        let today = new Date();
        let dd = String(today.getDate()).padStart(2, '0');
        let mm = String(today.getMonth() + 1).padStart(2, '0');
        let yyyy = today.getFullYear();
        let yyyy_min = today.getFullYear() - 100;

        let max = `${yyyy}-${mm}-${dd}`;
        let min = `${yyyy_min}-${mm}-${dd}`;
        $("input[type = 'date']").attr("max", max);
        $("input[type = 'date']").attr("min", min);
    </script>    
</body>
</html>