<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8"/>
		<title>Planify</title>
		<link href="/css/index.css" rel="stylesheet"/>
		<script src="https://code.jquery.com/jquery-3.7.1.js"></script>
	</head>
	<body>
		<header class="top-nav">
			<div class="left-nav">
				<img src="/images/menu.png" id="menu" width="44" height="34"/>
				<a href="/index">
					<img src="/images/logo.png" id="logo" width="170" height="40" />
				</a>				
			</div>
			<div class="right-nav">
				<a href="connection" id="connexion-b" class="button">Se connecter</a>
				<a href="inscription" id="inscription-b" class="button">S'inscrire</a>
			</div>
		</header>
		<main>
			<div class="left-main">

			</div>
			<div class="center-main">
				
			</div>
			<div class="right-main">
				
			</div>
		</main>
	</body>
	<script>
		let visible = true;
		$("#menu").click(function() {
			if (visible) {
				$(".left-main").css("display", "none");
				$("main").css("grid-template-columns", "80% 20%");
				visible = false;
			} else {
				$(".left-main").css("display", "block");
				$("main").css("grid-template-columns", "20% 60% 20%");
				visible = true;
			}
		});

		$("#menu").on("dragstart", function(event) {
			event.preventDefault();
		});
	</script>
</html>