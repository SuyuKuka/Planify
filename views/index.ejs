<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8"/>
		<title>Planify</title>
		<%- include('bootstrap_style') %>
		<link href="/css/nav.css" rel="stylesheet"/>
		<link href="/css/index.css" rel="stylesheet"/>
	</head>
	<body>
		<%- include('nav') %>
		<div class="container-fluid bg-warning" id="center-bar">
			<div class="row">
				<p>
					<a class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#left-bar" aria-expanded="false" aria-controls="left-bar">
						Toggle
					</a>
				</p>				  
			</div>
			<div class="row">
				<div class="bar col-sm-3 collapse collapse-horizontal" id="left-bar">
					1 of 3
				</div>
				<div class="bar col-sm" id="center-bar">
					2 of 3
				</div>
				<div class="bar col-sm-3" id="right-bar">
					3 of 3
				</div>
			</div>
		</div>
		<%- include('bootstrap_script') %>
	</body>
</html>