<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>Inscription - Planify</title>
        <%- include('bootstrap_style') %>
        <link href="/css/authentification.css" rel="stylesheet">
        <link href="/css/inscription.css" rel="stylesheet">
        <script src="/js/jquery.js"></script>
    </head>
    <body>
        <form autocomplete="off" action="inscription/verification" method="post" id="form">
            <header class="authentification">
                <h2>Inscription</h2>
            </header>

            <div id="step1">
                <div>
                    <label for="surname">Nom :</label><br>
                    <input type="text" name="surname" id="surname"
                        value="<%= typeof surname !== 'undefined' ? surname : '' %>"/>
                </div>
                <div>
                    <label for="name">Prénom :</label><br>
                    <input type="text" name="name" id="name"
                        value="<%= typeof name !== 'undefined' ? name : '' %>"/>
                </div>
                <div>
                    <label for="birthdate">Date de naissance :</label><br>
                    <input type="date" name="birthdate" id="birthdate"
                        min="1900-01-01"
                        max="<%= new Date().toISOString().split('T')[0] %>"
                        value="<%= typeof birthdate !== 'undefined' ? birthdate : '' %>"/>
                </div>
                <div class="error_message" id="error_step1" style="display: none;">
                    <label class="error">Les données spécifiées ne sont pas valides.</label>
                </div>
                <% if (typeof error_step1 !== 'undefined') { %>
                    <div class="error_message" id="error_step1ejs">
                        <label class="error"><%= error_step1.msg %></label>
                    </div>
                <% } %>
                <div class="suivant_div">
                    <button type="button" class="button" id="suivant">Suivant</button>
                </div>
            </div>

            <div id="step2">
                <div>
                    <label for="username">Pseudo :</label><br>
                    <input type="text" name="username" id="username"
                        value="<%= typeof username !== 'undefined' ? username : '' %>"/>
                </div>
                <div>
                    <label for="email">Adresse e-mail :</label><br>
                    <input type="email" name="email" id="email"
                        value="<%= typeof email !== 'undefined' ? email : '' %>"/>
                </div>
                <div>
                    <label for="password">Mot de passe :</label><br>
                    <input type="password" name="password" id="password"/>
                </div>
                <div class="show_password_div">
                    <input type="checkbox" name="show_password" id="show_password"/>
                    <label for="show_password">Afficher le mot de passe</label>
                </div>
                <div class="error_message" id="error_step2" style="display: none;">
                    <label class="error">Les données spécifiées ne sont pas valides.</label>
                </div>
                <% if (typeof error_step2 !== 'undefined') { %>
                    <div class="error_message" id="error_step2ejs">
                        <label class="error"><%= error_step2.msg %></label>
                    </div>
                <% } %>
                <div>
                    <button type="button" class="button" id="retour">Retour</button>
                    <input type="submit" id="inscription" value="Inscription">
                </div>
            </div>
        </form>
        <script src="/js/authentification.js"></script>
        <script src="/js/inscription.js"></script>
        <%- include('bootstrap_script') %>
    </body>
</html>